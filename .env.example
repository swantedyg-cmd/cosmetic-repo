# Public address of the site (canonical links, sitemap, social cards). Set to the client's domain at launch.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Shopify headless checkout. Leave empty to keep the bag in demo mode.
# Storefront API token: Shopify admin → Settings → Apps → Develop apps → Storefront API.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
# Variant ID of a hidden "Engraving" product priced at €8, added once per engraved item.
SHOPIFY_ENGRAVING_VARIANT_ID=gid://shopify/ProductVariant/0000000000
